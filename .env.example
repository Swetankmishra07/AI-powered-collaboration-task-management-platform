# Application Configuration
# Use development locally, testing for isolated tests, and production when deployed.
PROJECT_NAME="Smart Task Management API"
VERSION="1.0.0"
ENVIRONMENT="development"

# Database Configuration
# PostgreSQL is the production target for the upgraded architecture.
# Format: postgresql+psycopg://<user>:<password>@<host>:<port>/<db_name>
DATABASE_URL="postgresql+psycopg://task_user:password@localhost:5432/task_db"

# Tests use an isolated SQLite URL from tests/conftest.py.
# Never point tests at a development or production database.

# Security / JWT Configuration
# Generate a long random value. Never commit the real secret.
SECRET_KEY="replace-with-a-long-random-secret"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
JWT_ISSUER="smart-task-management-api"
JWT_AUDIENCE="smart-task-management-api-client"
BCRYPT_ROUNDS=12

# Optional cache/health dependency. Leave empty to run without Redis.
REDIS_URL="redis://localhost:6379/0"
REDIS_CACHE_TTL_SECONDS=30
