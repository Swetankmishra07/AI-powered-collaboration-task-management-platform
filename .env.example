# Application Configuration
# Use development locally, testing for isolated tests, and production when deployed.
PROJECT_NAME="Smart Task Management API"
VERSION="1.0.0"
ENVIRONMENT="development"

# Database Configuration
# PostgreSQL is the production target for the upgraded architecture.
# Format: postgresql+psycopg://<user>:<password>@<host>:<port>/<db_name>
DATABASE_URL="postgresql+psycopg://task_user:password@localhost:5432/task_db"

# Tests use an isolated SQLite URL from tests/conftest.py.
# Never point tests at a development or production database.

# Security / JWT Configuration
# Generate a long random value. Never commit the real secret.
SECRET_KEY="replace-with-a-long-random-secret"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
JWT_ISSUER="smart-task-management-api"
JWT_AUDIENCE="smart-task-management-api-client"
BCRYPT_ROUNDS=12

# Optional cache/health dependency. Leave empty to run without Redis.
REDIS_URL="redis://localhost:6379/0"
REDIS_CACHE_TTL_SECONDS=30

# Optional in-process durable job worker. Disabled by default for local/test use.
BACKGROUND_JOBS_ENABLED=false
BACKGROUND_JOBS_POLL_INTERVAL_SECONDS=5
BACKGROUND_JOBS_MAX_ATTEMPTS=3
BACKGROUND_JOBS_RETRY_DELAY_SECONDS=30
BACKGROUND_JOBS_SHUTDOWN_TIMEOUT_SECONDS=10

# Optional AI provider. Leave disabled or unset to keep AI routes unavailable.
AI_ENABLED=false
AI_PROVIDER="openai_compatible"
AI_API_KEY="replace-with-provider-key"
AI_API_URL="https://api.example.com/v1/chat/completions"
AI_MODEL="replace-with-model-name"
AI_REQUEST_TIMEOUT_SECONDS=20

# Local development/test attachment storage. The provider interface can support object storage later.
ATTACHMENT_STORAGE_PROVIDER="local"
ATTACHMENT_STORAGE_ROOT="./storage/attachments"
ATTACHMENT_MAX_FILE_SIZE_BYTES=10485760

# Comma-separated browser origins for API access. Leave empty to disable CORS.
CORS_ALLOWED_ORIGINS=""

# Docker Compose development database credentials. Replace placeholders locally.
POSTGRES_DB="task_db"
POSTGRES_USER="task_user"
POSTGRES_PASSWORD="replace-with-a-local-database-password"
API_PORT=8000
